
@model FlightBookingAI.Web.Models.Flight

@{
    ViewBag.Title = "Chi tiết chuyến bay";

    int passengers = ViewBag.Passengers != null
        ? (int)ViewBag.Passengers
        : 1;

    if (passengers < 1)
    {
        passengers = 1;
    }

    var duration = Model.ArrivalTime - Model.DepartureTime;

    var seatPercent = Model.TotalSeats > 0
        ? (int)Math.Round((double)Model.AvailableSeats
                          / Model.TotalSeats * 100)
        : 0;

    seatPercent = Math.Max(0, Math.Min(100, seatPercent));
}

<style>
    .flight-details-page {
        padding-top: 25px;
        padding-bottom: 40px;
        color: #17365D;
    }

    .booking-title {
        color: #123B72;
        font-weight: 750;
        margin-bottom: 8px;
    }

    .booking-subtitle {
        color: #718096;
        margin-bottom: 28px;
    }

    .booking-steps {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 30px;
        padding: 20px;
        background: #F5FAFF;
        border-radius: 14px;
    }

    .booking-step {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #8A9AAF;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
    }

        .booking-step.active {
            color: #1769D2;
        }

    .step-number {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #E1EAF4;
        color: #718096;
        font-weight: 700;
    }

    .booking-step.active .step-number {
        background: #1769D2;
        color: white;
    }

    .step-line {
        height: 2px;
        flex: 1;
        background: #D8E4F0;
        max-width: 100px;
    }

    .flight-detail-card {
        background: white;
        border: 1px solid #E7EDF5;
        border-radius: 18px;
        box-shadow: 0 5px 22px rgba(20, 55, 95, 0.07);
        overflow: hidden;
    }

    .airline-header {
        padding: 25px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #E8EEF5;
    }

    .airline-icon {
        width: 52px;
        height: 52px;
        border-radius: 13px;
        background: #E8F4FF;
        color: #1769D2;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .airline-logo {
        width: 86px;
        height: 64px;
        border-radius: 12px;
        background: #FFFFFF;
        border: 1px solid #E3EDF5;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(20, 55, 95, 0.06);
    }

    .airline-logo-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .airline-logo span {
        font-size: 26px;
        color: #1769D2;
    }

    .flight-route {
        padding: 40px 30px;
    }

    .route-time {
        font-size: 32px;
        font-weight: 750;
        color: #123B72;
    }

    .airport-code {
        font-size: 23px;
        font-weight: 750;
        color: #1769D2;
        margin-top: 5px;
    }

    .airport-city {
        color: #718096;
        font-size: 14px;
        margin-top: 4px;
    }

    .route-line {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 15px 0;
        color: #20A5C5;
    }

        .route-line hr {
            flex: 1;
            border: 0;
            border-top: 2px solid #20A5C5;
            margin: 0;
        }

    .flight-summary {
        padding: 25px 30px;
        background: #F4F9FF;
        border-top: 1px solid #E5EDF6;
    }

    .seat-progress {
        height: 9px;
        background: #DDE7F0;
        border-radius: 20px;
        overflow: hidden;
        margin-top: 12px;
    }

    .seat-progress-bar {
        height: 100%;
        background: #16A36A;
        border-radius: 20px;
    }

    .price-value {
        font-size: 30px;
        font-weight: 750;
        color: #1769D2;
    }

    .continue-button {
        background: #1769D2;
        border: none;
        color: white;
        padding: 13px 25px;
        border-radius: 9px;
        font-weight: 650;
        transition: 0.2s;
    }

        .continue-button:hover {
            background: #1055AE;
            color: white;
        }

    .back-button {
        border: 1px solid #CBD5E1;
        color: #52657A;
        padding: 12px 22px;
        border-radius: 9px;
        text-decoration: none;
        display: inline-block;
    }

        .back-button:hover {
            background: #F1F5F9;
            color: #123B72;
            text-decoration: none;
        }

    @@media (max-width: 576px) {
        .booking-steps {
            gap: 5px;
            padding: 12px 5px;
        }

        .booking-step {
            flex-direction: column;
            font-size: 11px;
            gap: 4px;
        }

        .step-line {
            max-width: 30px;
        }

        .airline-header {
            padding: 18px;
        }

        .flight-route {
            padding: 25px 12px;
        }

        .route-time {
            font-size: 23px;
        }

        .airport-code {
            font-size: 19px;
        }

        .flight-summary {
            padding: 20px;
        }

        .price-value {
            font-size: 25px;
        }
    }

    /* BANNER GÓC NHÌN TỪ CỬA SỔ MÁY BAY */
    .airplane-window-banner {
        min-height: 240px;
        margin-bottom: 30px;
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        align-items: center;

        background-image:
            linear-gradient(
                90deg,
                rgba(8, 40, 85, 0.88) 0%,
                rgba(8, 65, 105, 0.52) 48%,
                rgba(8, 65, 105, 0.05) 100%
            ),
            url('@Url.Content("~/Images/Banners/banner-airplane-window.png")');

        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .airplane-window-content {
        padding: 35px;
        max-width: 620px;
        color: white;
    }

    .airplane-window-tag {
        display: inline-block;
        padding: 7px 14px;
        background: #DDF8F4;
        color: #087D83;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .airplane-window-content h3 {
        font-size: 29px;
        font-weight: 750;
        margin: 15px 0 10px;
    }

    .airplane-window-content p {
        color: #E8F7FF;
        margin-bottom: 0;
        line-height: 1.7;
    }

    @@media (max-width: 576px) {
        .airplane-window-banner {
            min-height: 210px;
            background-position: 60% center;
        }

        .airplane-window-content {
            padding: 22px;
        }

        .airplane-window-content h3 {
            font-size: 22px;
        }
    }

</style>

<div class="flight-details-page">

    <!-- TIÊU ĐỀ -->
    <div class="mb-4">
        <h2 class="booking-title">
            ✈ Chi tiết chuyến bay
        </h2>

        <p class="booking-subtitle">
            Kiểm tra thông tin hành trình trước khi lựa chọn chỗ ngồi.
        </p>
    </div>

    <!-- TIẾN TRÌNH ĐẶT VÉ -->
    <div class="booking-steps">

        <div class="booking-step active">
            <div class="step-number">1</div>
            <span>Chuyến bay</span>
        </div>

        <div class="step-line"></div>

        <div class="booking-step">
            <div class="step-number">2</div>
            <span>Chọn ghế</span>
        </div>

        <div class="step-line"></div>

        <div class="booking-step">
            <div class="step-number">3</div>
            <span>Thanh toán</span>
        </div>

    </div>

    <!-- BANNER GÓC NHÌN TỪ MÁY BAY -->
    <section class="airplane-window-banner">
        <div class="airplane-window-content">

            <span class="airplane-window-tag">
                ✈ KHÁM PHÁ CÙNG FLIGHTBOOKINGAI
            </span>

            <h3>
                Bay đến những chân trời mới!
            </h3>

            <p>
                Tận hưởng hành trình trên những tầng mây,
                khám phá vẻ đẹp của thế giới từ một góc nhìn khác.
            </p>

        </div>
    </section>

    <!-- THẺ CHI TIẾT CHUYẾN BAY -->
    <div class="flight-detail-card">

        <!-- THÔNG TIN HÃNG BAY -->
        <div class="airline-header">

            <div class="d-flex align-items-center gap-3">


                <div class="airline-logo">
                    @if (Model.Airline != null &&
                         !string.IsNullOrEmpty(Model.Airline.LogoURL))
                    {
                        <img src="@Url.Content("~" + Model.Airline.LogoURL)"
                             alt="@Model.Airline.AirlineName"
                             class="airline-logo-img" />
                    }
                    else
                    {
                        <span>✈</span>
                    }
                </div>


                <div>
                    <h4 class="fw-bold mb-1">
                        @(Model.Airline != null
                            ? Model.Airline.AirlineName
                            : "Hãng hàng không")
                    </h4>

                    <span class="text-muted">
                        @Model.FlightNumber · Chuyến bay thẳng
                    </span>
                </div>

            </div>

            @if (Model.AvailableSeats > 0
                && Model.Status == "Scheduled")
            {
                <span class="badge bg-success p-2">
                    Đang mở bán
                </span>
            }
            else
            {
                <span class="badge bg-secondary p-2">
                    @Model.Status
                </span>
            }

        </div>

        <!-- TIMELINE HÀNH TRÌNH -->
        <div class="flight-route">

            <div class="row align-items-center text-center">

                <!-- SÂN BAY ĐI -->
                <div class="col-4">

                    <div class="route-time">
                        @Model.DepartureTime.ToString("HH:mm")
                    </div>

                    <div class="airport-code">
                        @(Model.Airport1 != null
                            ? Model.Airport1.AirportCode
                            : "---")
                    </div>

                    <div class="airport-city">
                        @(Model.Airport1 != null
                            ? Model.Airport1.City
                            : "Sân bay đi")
                    </div>

                    <div class="small text-muted mt-2">
                        @Model.DepartureTime.ToString("dd/MM/yyyy")
                    </div>

                </div>

                <!-- ĐƯỜNG BAY -->
                <div class="col-4">

                    <div class="text-muted small mb-2">
                        @((int)duration.TotalHours) giờ
                        @duration.Minutes phút
                    </div>

                    <div class="route-line">
                        <hr />
                        <span style="font-size:25px;">✈</span>
                        <hr />
                    </div>

                    <span class="badge rounded-pill"
                          style="background:#DFF5F2;color:#168F83;">
                        Bay thẳng
                    </span>

                </div>

                <!-- SÂN BAY ĐẾN -->
                <div class="col-4">

                    <div class="route-time">
                        @Model.ArrivalTime.ToString("HH:mm")
                    </div>

                    <div class="airport-code">
                        @(Model.Airport != null
                            ? Model.Airport.AirportCode
                            : "---")
                    </div>

                    <div class="airport-city">
                        @(Model.Airport != null
                            ? Model.Airport.City
                            : "Sân bay đến")
                    </div>

                    <div class="small text-muted mt-2">
                        @Model.ArrivalTime.ToString("dd/MM/yyyy")
                    </div>

                </div>

            </div>

        </div>

        <!-- THÔNG TIN GIÁ VÉ VÀ GHẾ -->
        <div class="flight-summary">

            <div class="row align-items-center gy-4">

                <!-- GIÁ VÉ -->
                <div class="col-md-5">

                    <div class="text-muted mb-2">
                        Giá vé mỗi hành khách
                    </div>

                    <div class="price-value">
                        @Model.Price.ToString("N0") ₫
                    </div>

                    <small class="text-muted">
                        Giá vé hiển thị từ hệ thống
                    </small>

                </div>

                <!-- TÌNH TRẠNG GHẾ -->
                <div class="col-md-7">

                    <div class="d-flex justify-content-between
                                align-items-center">

                        <strong>
                            Tình trạng chỗ ngồi
                        </strong>

                        <span class="text-success fw-bold">
                            @Model.AvailableSeats ghế trống
                        </span>

                    </div>

                    <div class="seat-progress">
                        <div class="seat-progress-bar"
                             style="@("width:" + seatPercent + "%")">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between
                                mt-2 small text-muted">

                        <span>
                            @Model.AvailableSeats ghế còn trống
                        </span>

                        <span>
                            Tổng @Model.TotalSeats ghế
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- NÚT ĐIỀU HƯỚNG -->
        <div class="p-4 d-flex justify-content-between
                    align-items-center flex-wrap gap-3">

            <a href="@Url.Action("Index", "Flights")"
               class="back-button">
                ← Quay lại danh sách
            </a>


            @if (Model.AvailableSeats >= passengers &&
                 Model.Status == "Scheduled")
            {
                <a href="@Url.Action("SeatSelection", "Flights",
             new { id = Model.FlightID, passengers = passengers })"
                   class="continue-button"
                   style="display:inline-block; text-decoration:none;">
                    ✈ Tiếp tục chọn ghế →
                </a>
            }

            else
            {
                <button type="button"
                        class="btn btn-secondary"
                        disabled>
                    Chuyến bay không khả dụng
                </button>
            }

        </div>

    </div>

</div>
