
@using System
@using System.Linq
@model IEnumerable<FlightBookingAI.Web.Models.Flight>

@{
    ViewBag.Title = "Kết quả tìm kiếm chuyến bay";

    // Lấy số lượng hành khách từ FlightsController
    int passengers = ViewBag.Passengers != null
        ? (int)ViewBag.Passengers
        : 1;

    // Đảm bảo số lượng hành khách hợp lệ
    if (passengers < 1)
    {
        passengers = 1;
    }
}

@if (TempData["BookingSuccess"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["BookingSuccess"]
    </div>
}

@if (TempData["BookingError"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["BookingError"]
    </div>
}

<style>

/* BANNER KẾT QUẢ TÌM KIẾM */
.search-flight-banner {
    position: relative;
    min-height: 220px;
    margin-bottom: 28px;
    border-radius: 18px;
    overflow: hidden;

    display: flex;
    align-items: center;

    background-image:
        linear-gradient(
            90deg,
            rgba(10, 48, 92, 0.90) 0%,
            rgba(10, 75, 120, 0.40) 48%,
            rgba(10, 75, 120, 0.05) 100%
        ),
        url('@Url.Content("~/Images/Banners/banner-search.jpg")');

    background-size: cover;
    background-position: center 70%;
    background-repeat: no-repeat;

    box-shadow: 0 5px 20px rgba(20, 55, 95, 0.08);
}


    .search-flight-banner-content {
        padding: 30px 35px;
        max-width: 650px;
        color: white;
    }

    .search-flight-banner-tag {
        display: inline-block;
        padding: 6px 13px;
        border-radius: 20px;
        background: #DDF8F4;
        color: #087D83;
        font-size: 12px;
        font-weight: 700;
    }

    .search-flight-banner-content h2 {
        margin: 12px 0 8px;
        font-size: 27px;
        font-weight: 750;
        color: white;
    }

    .search-flight-banner-content p {
        margin: 0;
        color: #E8F7FF;
        font-size: 14px;
        line-height: 1.6;
    }

    @@media (max-width: 576px) {
        .search-flight-banner {
            min-height: 175px;
            background-position: 60% center;
        }

        .search-flight-banner-content {
            padding: 22px;
        }

        .search-flight-banner-content h2 {
            font-size: 21px;
        }
    }
</style>

<div class="container py-4">

    <!-- BANNER KẾT QUẢ TÌM KIẾM -->
    <section class="search-flight-banner">

        <div class="search-flight-banner-content">

            <span class="search-flight-banner-tag">
                ✈ FLIGHTBOOKINGAI
            </span>

            <h2>
                Sẵn sàng cho hành trình tiếp theo?
            </h2>

            <p>
                Khám phá các chuyến bay phù hợp,
                lựa chọn hành trình lý tưởng và bắt đầu chuyến đi của bạn.
            </p>

        </div>

    </section>

    <!-- TIÊU ĐỀ -->
    <div class="mb-4">
        <h2 class="fw-bold" style="color:#123B72;">
            ✈ Kết quả tìm kiếm chuyến bay
        </h2>
        <p class="text-muted">
            Khám phá các chuyến bay phù hợp với hành trình của bạn.
        </p>
    </div>

    @if (!Model.Any())
    {
        <!-- KHÔNG CÓ KẾT QUẢ -->
        <div class="card border-0 shadow-sm text-center p-5">

            <div style="font-size:55px;">✈️</div>

            <h4 class="fw-bold mt-3" style="color:#123B72;">
                Không tìm thấy chuyến bay
            </h4>

            <p class="text-muted mt-2">
                Rất tiếc, hiện tại không có chuyến bay
                phù hợp với điều kiện tìm kiếm của bạn.
            </p>

            <p class="text-muted">
                Vui lòng kiểm tra lại sân bay đi,
                sân bay đến hoặc ngày khởi hành.
            </p>

            <div class="mt-3">
                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-primary px-4">
                    🔍 Tìm kiếm lại
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- SỐ LƯỢNG KẾT QUẢ -->
        <div class="alert alert-info mb-4">
            Tìm thấy
            <strong>@Model.Count()</strong>
            chuyến bay phù hợp.
        </div>

        foreach (var item in Model)
        {
            var duration = item.ArrivalTime - item.DepartureTime;

            <div class="card border-0 shadow-sm mb-4"
                 style="border-radius:16px; overflow:hidden;">

                <div class="card-body p-4">

                    <!-- HÃNG HÀNG KHÔNG -->
                    <div class="d-flex justify-content-between
                                align-items-center mb-4">

                        <div>
                            <h5 class="fw-bold mb-1"
                                style="color:#123B72;">
                                @(item.Airline != null
                                    ? item.Airline.AirlineName
                                    : "Hãng hàng không")
                            </h5>

                            <small class="text-muted">
                                Chuyến bay: @item.FlightNumber
                            </small>
                        </div>

                        @if (item.AvailableSeats > 0)
                        {
                            <span class="badge bg-success p-2">
                                Còn ghế
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger p-2">
                                Hết ghế
                            </span>
                        }
                    </div>

                    <!-- THÔNG TIN HÀNH TRÌNH -->
                    <div class="row align-items-center text-center">

                        <!-- NƠI ĐI -->
                        <div class="col-md-4 mb-3 mb-md-0">

                            <h3 class="fw-bold mb-1">
                                @item.DepartureTime.ToString("HH:mm")
                            </h3>

                            <h5 style="color:#123B72;">
                                @(item.Airport1 != null
                                    ? item.Airport1.AirportCode
                                    : "---")
                            </h5>

                            <small class="text-muted">
                                @item.DepartureTime.ToString("dd/MM/yyyy")
                            </small>
                        </div>

                        <!-- THỜI GIAN BAY -->
                        <div class="col-md-4 mb-3 mb-md-0">

                            <p class="text-muted mb-2">
                                @((int)duration.TotalHours) giờ
                                @duration.Minutes phút
                            </p>

                            <div class="d-flex align-items-center
                                        justify-content-center">

                                <hr style="width:35%;
                                           border:1px solid #0d6efd;" />

                                <span class="mx-2"
                                      style="color:#0d6efd;">
                                    ✈
                                </span>

                                <hr style="width:35%;
                                           border:1px solid #0d6efd;" />
                            </div>

                            <small class="text-muted">
                                Thời gian bay dự kiến
                            </small>
                        </div>

                        <!-- NƠI ĐẾN -->
                        <div class="col-md-4">

                            <h3 class="fw-bold mb-1">
                                @item.ArrivalTime.ToString("HH:mm")
                            </h3>

                            <h5 style="color:#123B72;">
                                @(item.Airport != null
                                    ? item.Airport.AirportCode
                                    : "---")
                            </h5>

                            <small class="text-muted">
                                @item.ArrivalTime.ToString("dd/MM/yyyy")
                            </small>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- GIÁ VÉ VÀ NÚT CHỌN -->
                    <div class="d-flex justify-content-between
                                align-items-center flex-wrap gap-3">

                        <div>
                            <h4 class="fw-bold text-primary mb-1">
                                @item.Price.ToString("N0") ₫
                            </h4>

                            <small class="text-muted">
                                @item.AvailableSeats ghế còn trống
                            </small>
                        </div>


                        @if (item.AvailableSeats > 0 && item.Status == "Scheduled")
                        {
                            <a href="@Url.Action("Details", "Flights",
         new { id = item.FlightID, passengers = passengers })"
                               class="btn btn-primary px-4 py-2">
                                ✈ Chọn chuyến bay
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-secondary px-4 py-2"
                                    disabled>
                                Chuyến bay không khả dụng
                            </button>
                        }

                    </div>

                </div>
            </div>
        }
    }

</div>
