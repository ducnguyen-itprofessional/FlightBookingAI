
@using System
@using System.Linq
@model IEnumerable<FlightBookingAI.Web.Models.Flight>

@{
    ViewBag.Title = "Kết quả tìm kiếm chuyến bay";

    int passengers = ViewBag.Passengers != null
        ? (int)ViewBag.Passengers
        : 1;

    if (passengers < 1)
    {
        passengers = 1;
    }
}

<style>
    /* ==============================
       BANNER KẾT QUẢ TÌM KIẾM
    ============================== */

    .search-flight-banner {
        position: relative;
        min-height: 220px;
        margin-bottom: 28px;
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        align-items: center;

        background-image:
            linear-gradient(
                90deg,
                rgba(10, 48, 92, 0.90) 0%,
                rgba(10, 75, 120, 0.40) 48%,
                rgba(10, 75, 120, 0.05) 100%
            ),
            url('@Url.Content("~/Images/Banners/banner-search.jpg")');

        background-size: cover;
        background-position: center 70%;
        background-repeat: no-repeat;

        box-shadow: 0 5px 20px rgba(20, 55, 95, 0.08);
    }

    .search-flight-banner-content {
        padding: 30px 35px;
        max-width: 650px;
        color: white;
    }

    .search-flight-banner-tag {
        display: inline-block;
        padding: 6px 13px;
        border-radius: 20px;
        background: #DDF8F4;
        color: #087D83;
        font-size: 12px;
        font-weight: 700;
    }

    .search-flight-banner-content h2 {
        margin: 12px 0 8px;
        font-size: 27px;
        font-weight: 750;
        color: white;
    }

    .search-flight-banner-content p {
        margin: 0;
        color: #E8F7FF;
        font-size: 14px;
        line-height: 1.6;
    }

    /* ==============================
       THẺ KẾT QUẢ CHUYẾN BAY
    ============================== */

    .flight-result-card {
        display: flex;
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        margin-bottom: 18px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.10);
        border: 1px solid #e8edf2;
        transition: transform 0.2s, box-shadow 0.2s;
        width: 100%;
    }

    .flight-result-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 7px 20px rgba(0,0,0,0.12);
    }

    .flight-info {
        flex: 1;
        padding: 10px 18px;
        min-width: 0;
    }

    .flight-airline {
        color: #123B72;
        font-size: 17px;
        font-weight: 700;
    }

    .flight-number {
        color: #758397;
        font-size: 12px;
        margin-top: 3px;
    }

    /* ==============================
       THÔNG TIN HÀNH TRÌNH
    ============================== */

    .flight-route {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
        text-align: center;
        margin-top: 28px;
    }

    .flight-time {
        font-size: 29px;
        font-weight: 750;
        color: #123B72;
    }

    .flight-airport {
        font-size: 17px;
        font-weight: 700;
        color: #123B72;
        margin-top: 5px;
    }

    .flight-city {
        font-size: 13px;
        color: #788697;
        margin-top: 4px;
    }

    .flight-duration {
        font-size: 12px;
        color: #68788b;
        margin-bottom: 6px;
    }

    .flight-line {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #087D83;
        font-size: 17px;
    }

    .flight-line hr {
        width: 35%;
        border: 1px solid #087D83;
        opacity: 1;
    }

    /* ==============================
       KHU VỰC GIÁ VÉ PHỔ THÔNG
    ============================== */

    .flight-fare {
        width: 245px;
        min-width: 245px;
        background: #086477;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 25px 15px;
    }

    .flight-fare-label {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .flight-fare-price {
        font-size: 25px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .flight-fare-seats {
        font-size: 13px;
        color: #e0f4f4;
        margin-bottom: 20px;
    }

    .flight-fare .btn {
        background: white;
        color: #086477;
        border: none;
        font-weight: 700;
        padding: 7px 18px;
        border-radius: 8px;
        text-decoration: none;
    }

    .flight-fare .btn:hover {
        background: #e5f5f5;
        color: #064b59;
    }

    .flight-fare .btn:disabled {
        background: #d5dce1;
        color: #68788b;
    }

    /* ==============================
       RESPONSIVE - ĐIỆN THOẠI
    ============================== */

    @@media (max-width: 768px) {
        .flight-result-card {
            flex-direction: column;
        }

        .flight-fare {
            width: 100%;
            min-width: 0;
        }

        .flight-info {
            padding: 20px 15px;
        }

        .flight-time {
            font-size: 23px;
        }

        .flight-airport {
            font-size: 15px;
        }
    }

    @@media (max-width: 576px) {
        .search-flight-banner {
            min-height: 175px;
            background-position: 60% center;
        }

        .search-flight-banner-content {
            padding: 22px;
        }

        .search-flight-banner-content h2 {
            font-size: 21px;
        }
    }
</style>

<div class="container py-4">

    <!-- THÔNG BÁO ĐẶT VÉ -->
    @if (TempData["BookingSuccess"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["BookingSuccess"]
        </div>
    }

    @if (TempData["BookingError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["BookingError"]
        </div>
    }

    <!-- BANNER KẾT QUẢ TÌM KIẾM -->
    <section class="search-flight-banner">

        <div class="search-flight-banner-content">

            <span class="search-flight-banner-tag">
                ✈ FLIGHTBOOKINGAI
            </span>

            <h2>
                Sẵn sàng cho hành trình tiếp theo?
            </h2>

            <p>
                Khám phá các chuyến bay phù hợp,
                lựa chọn hành trình lý tưởng và bắt đầu chuyến đi của bạn.
            </p>

        </div>

    </section>

    <!-- TIÊU ĐỀ -->
    <div class="mb-4">

        <h2 class="fw-bold" style="color:#123B72;">
            ✈ Kết quả tìm kiếm chuyến bay
        </h2>

        <p class="text-muted">
            Khám phá các chuyến bay phù hợp với hành trình của bạn.
        </p>

    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- KHÔNG CÓ KẾT QUẢ -->
        <div class="card border-0 shadow-sm text-center p-5">

            <div style="font-size:55px;">✈️</div>

            <h4 class="fw-bold mt-3" style="color:#123B72;">
                Không tìm thấy chuyến bay
            </h4>

            <p class="text-muted mt-2">
                Rất tiếc, hiện tại không có chuyến bay
                phù hợp với điều kiện tìm kiếm của bạn.
            </p>

            <p class="text-muted">
                Vui lòng kiểm tra lại sân bay đi,
                sân bay đến hoặc ngày khởi hành.
            </p>

            <div class="mt-3">

                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-primary px-4">
                    🔍 Tìm kiếm lại
                </a>

            </div>

        </div>
    }
    else
    {
        <!-- SỐ LƯỢNG KẾT QUẢ -->
        <div class="alert alert-info mb-4">

            Tìm thấy
            <strong>@Model.Count()</strong>
            chuyến bay phù hợp.

        </div>

        <!-- DANH SÁCH CHUYẾN BAY -->
        foreach (var item in Model)
        {
            var duration = item.ArrivalTime - item.DepartureTime;

            <div class="flight-result-card">

                <!-- THÔNG TIN CHUYẾN BAY -->
                <div class="flight-info">

                    <!-- HÃNG HÀNG KHÔNG -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <div>

                            <div class="flight-airline">
                                @(item.Airline != null
                                    ? item.Airline.AirlineName
                                    : "Hãng hàng không")
                            </div>

                            <div class="flight-number">
                                Mã chuyến bay: @item.FlightNumber
                            </div>

                        </div>

                        @if (item.AvailableSeats > 0)
                        {
                            <span class="badge bg-success p-2">
                                Còn @item.AvailableSeats ghế
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger p-2">
                                Hết ghế
                            </span>
                        }

                    </div>

                    <!-- THÔNG TIN HÀNH TRÌNH -->
                    <div class="flight-route">

                        <!-- NƠI ĐI -->
                        <div>

                            <div class="flight-time">
                                @item.DepartureTime.ToString("HH:mm")
                            </div>

                            <div class="flight-airport">
                                @(item.Airport1 != null
                                    ? item.Airport1.AirportCode
                                    : "---")
                            </div>

                            <div class="flight-city">
                                @(item.Airport1 != null
                                    ? item.Airport1.City
                                    : "Chưa xác định")
                            </div>

                            <div class="flight-city">
                                @item.DepartureTime.ToString("dd/MM/yyyy")
                            </div>

                        </div>

                        <!-- THỜI GIAN BAY -->
                        <div>

                            <div class="flight-duration">
                                @((int)duration.TotalHours) giờ
                                @duration.Minutes phút
                            </div>

                            <div class="flight-line">
                                <hr />
                                ✈
                                <hr />
                            </div>

                            <div class="flight-duration mt-2">
                                Thời gian bay
                            </div>

                        </div>

                        <!-- NƠI ĐẾN -->
                        <div>

                            <div class="flight-time">
                                @item.ArrivalTime.ToString("HH:mm")
                            </div>

                            <div class="flight-airport">
                                @(item.Airport != null
                                    ? item.Airport.AirportCode
                                    : "---")
                            </div>

                            <div class="flight-city">
                                @(item.Airport != null
                                    ? item.Airport.City
                                    : "Chưa xác định")
                            </div>

                            <div class="flight-city">
                                @item.ArrivalTime.ToString("dd/MM/yyyy")
                            </div>

                        </div>

                    </div>

                </div>

                <!-- HẠNG VÉ PHỔ THÔNG -->
                <div class="flight-fare">

                    <div class="flight-fare-label">
                        PHỔ THÔNG
                    </div>

                    <div class="flight-fare-price">
                        @item.Price.ToString("N0")
                    </div>

                    <div style="font-size:13px; margin-bottom:15px;">
                        VNĐ / khách
                    </div>

                    <div class="flight-fare-seats">
                        @item.AvailableSeats ghế còn lại
                    </div>

                    @if (item.AvailableSeats >= passengers
                        && item.Status == "Scheduled")
                    {
                        <a href="@Url.Action("Details", "Flights",
                            new {
                                id = item.FlightID,
                                passengers = passengers
                            })"
                           class="btn">

                            Chọn vé ✈

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn"
                                disabled>

                            Không khả dụng

                        </button>
                    }

                </div>

            </div>
        }
    }

</div>
