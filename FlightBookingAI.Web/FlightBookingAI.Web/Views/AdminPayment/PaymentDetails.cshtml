
@model FlightBookingAI.Web.Models.AdminRevenueReportViewModel
@using System.Linq
@using System.Globalization

@{
    Layout = null;
    ViewBag.Title = "Chi tiết doanh thu";

    decimal maxRevenue = Model.MonthlyRevenues.Any()
        ? Model.MonthlyRevenues.Max(x => x.Revenue)
        : 0;

    if (maxRevenue <= 0)
    {
        maxRevenue = 1;
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Chi tiết doanh thu - AER Aviation</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            background: #101114;
            color: #f5f5f5;
            font-family: Arial, sans-serif;
            overflow-x: hidden;
        }

        .container {
            width: 100%;
            min-height: 100vh;
            padding: 30px;
            margin: 0;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 18px;
            margin-bottom: 30px;
        }

            .header h1 {
                color: #e0ad45;
                margin: 0 0 10px;
                font-size: 28px;
            }

            .header p {
                color: #aaa;
                margin: 0;
            }

        .back-btn {
            display: inline-block;
            padding: 12px 18px;
            background: #292929;
            border: 1px solid #555;
            border-radius: 7px;
            color: #fff;
            text-decoration: none;
            transition: 0.2s;
        }

            .back-btn:hover {
                background: #e0ad45;
                color: #111;
            }

        .filter-section,
        .section {
            background: #1b1c20;
            border: 1px solid #333;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
        }

            .section h3,
            .filter-section h3 {
                color: #e0ad45;
                margin: 0 0 22px;
                padding-bottom: 13px;
                border-bottom: 1px solid #383838;
                font-size: 18px;
            }

        .filter-form {
            display: flex;
            align-items: flex-end;
            flex-wrap: wrap;
            gap: 15px;
        }

        .date-field {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 200px;
        }

            .date-field label {
                color: #aaa;
                font-size: 13px;
            }

            .date-field input {
                padding: 12px;
                background: #101114;
                color: #fff;
                border: 1px solid #444;
                border-radius: 7px;
                outline: none;
            }

                .date-field input:focus {
                    border-color: #e0ad45;
                }

        .filter-btn,
        .reset-btn {
            padding: 12px 18px;
            border-radius: 7px;
            text-decoration: none;
            font-size: 14px;
            cursor: pointer;
            border: 1px solid #e0ad45;
            transition: 0.2s;
        }

        .filter-btn {
            background: #e0ad45;
            color: #111;
            font-weight: bold;
        }

        .reset-btn {
            background: transparent;
            color: #e0ad45;
        }

        .filter-btn:hover {
            background: #f0c76d;
        }

        .reset-btn:hover {
            background: #e0ad45;
            color: #111;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .summary-card {
            background: #1b1c20;
            border: 1px solid #333;
            border-radius: 12px;
            padding: 23px;
            min-width: 0;
        }

            .summary-card .card-title {
                color: #aaa;
                font-size: 14px;
                margin-bottom: 17px;
            }

            .summary-card .card-value {
                font-size: 25px;
                font-weight: bold;
                color: #e0ad45;
                overflow-wrap: anywhere;
            }

            .summary-card .card-description {
                color: #888;
                font-size: 12px;
                margin-top: 12px;
            }

            .summary-card .card-icon {
                color: #e0ad45;
                font-size: 21px;
                margin-bottom: 15px;
            }

        .revenue-banner {
            background: linear-gradient(120deg, #25231e, #171717);
            border: 1px solid #705722;
            border-radius: 12px;
            padding: 27px;
            margin-bottom: 25px;
        }

            .revenue-banner h2 {
                color: #e0ad45;
                font-size: 16px;
                margin: 0 0 15px;
            }

        .revenue-total {
            color: #e0ad45;
            font-size: 34px;
            font-weight: bold;
            overflow-wrap: anywhere;
        }

        .revenue-banner p {
            color: #aaa;
            margin-bottom: 0;
        }

        .monthly-list {
            display: flex;
            flex-direction: column;
            gap: 19px;
        }

        .monthly-item {
            display: grid;
            grid-template-columns: 120px minmax(100px, 1fr) 180px;
            align-items: center;
            gap: 18px;
        }

        .monthly-label {
            color: #ddd;
            font-size: 14px;
            font-weight: bold;
        }

        .monthly-track {
            width: 100%;
            height: 13px;
            background: #303136;
            border-radius: 20px;
            overflow: hidden;
        }

        .monthly-fill {
            height: 100%;
            background: linear-gradient(90deg, #a97a25, #e0ad45);
            border-radius: 20px;
            width: 0;
        }

        .monthly-value {
            color: #e0ad45;
            font-size: 14px;
            font-weight: bold;
            text-align: right;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 950px;
            border-collapse: collapse;
        }

        thead {
            background: #292929;
        }

        th {
            color: #e0ad45;
            padding: 16px 13px;
            text-align: left;
            font-size: 13px;
            white-space: nowrap;
        }

        td {
            padding: 16px 13px;
            border-bottom: 1px solid #353535;
            color: #eee;
            font-size: 14px;
            vertical-align: middle;
        }

        tbody tr:hover {
            background: #242529;
        }

        .highlight {
            color: #e0ad45;
            font-weight: bold;
        }

        .status {
            display: inline-block;
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            white-space: nowrap;
        }

        .status-success {
            background: #164b32;
            color: #7ce5a8;
        }

        .status-pending {
            background: #59451c;
            color: #ffda78;
        }

        .status-failed {
            background: #582525;
            color: #ff9292;
        }

        .status-refunded {
            background: #343b59;
            color: #b8c6ff;
        }

        .empty-data,
        .empty-table {
            text-align: center;
            color: #999;
            padding: 35px 15px;
        }

            .empty-data i {
                color: #e0ad45;
                font-size: 30px;
                margin-bottom: 12px;
            }

        .error-message {
            background: #582525;
            color: #ffb0b0;
            border: 1px solid #8a3838;
            padding: 15px 18px;
            border-radius: 8px;
            margin-bottom: 22px;
        }

        .footer {
            text-align: center;
            color: #777;
            margin-top: 30px;
            padding-bottom: 15px;
            font-size: 13px;
        }

        @@media (max-width: 1000px) {
            .summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 650px) {
            .container {
                padding: 15px;
            }

            .summary-grid {
                grid-template-columns: 1fr;
            }

            .monthly-item {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .monthly-value {
                text-align: left;
            }

            .revenue-total {
                font-size: 26px;
            }

            .header h1 {
                font-size: 23px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- HEADER -->
        <div class="header">
            <div>
                <h1>
                    <i class="fa-solid fa-chart-line"></i>
                    Chi tiết doanh thu
                </h1>
                <p>Phân tích doanh thu và lịch sử giao dịch thanh toán</p>
            </div>

            <a href="@Url.Action("Index", "AdminReport")" class="back-btn">
                <i class="fa-solid fa-arrow-left"></i>
                Quay lại báo cáo
            </a>
        </div>

        @if (ViewBag.ReportError != null)
        {
            <div class="error-message">
                <i class="fa-solid fa-circle-exclamation"></i>
                @ViewBag.ReportError
            </div>
        }

        <!-- DATE FILTER -->
        <div class="filter-section">
            <h3>
                <i class="fa-solid fa-filter"></i>
                LỌC BÁO CÁO DOANH THU
            </h3>

            @using (Html.BeginForm("RevenueDetails", "AdminReport", FormMethod.Get))
            {
                <div class="filter-form">

                    <div class="date-field">
                        <label for="fromDate">Từ ngày</label>
                        <input type="date"
                               id="fromDate"
                               name="fromDate"
                               value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="date-field">
                        <label for="toDate">Đến ngày</label>
                        <input type="date"
                               id="toDate"
                               name="toDate"
                               value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <button type="submit" class="filter-btn">
                        <i class="fa-solid fa-filter"></i>
                        Lọc dữ liệu
                    </button>

                    <a href="@Url.Action("RevenueDetails", "AdminReport")"
                       class="reset-btn">
                        <i class="fa-solid fa-rotate-left"></i>
                        Đặt lại
                    </a>

                </div>
            }
        </div>

        <!-- REVENUE BANNER -->
        <div class="revenue-banner">
            <h2>
                <i class="fa-solid fa-sack-dollar"></i>
                TỔNG DOANH THU THÀNH CÔNG
            </h2>

            <div class="revenue-total">
                @Model.TotalRevenue.ToString("N0") VNĐ
            </div>

            <p>
                Thống kê từ
                @Model.FromDate.ToString("dd/MM/yyyy")
                đến
                @Model.ToDate.ToString("dd/MM/yyyy")
            </p>
        </div>

        <!-- SUMMARY -->
        <div class="summary-grid">

            <div class="summary-card">
                <div class="card-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="card-title">Thanh toán thành công</div>
                <div class="card-value">
                    @Model.SuccessfulPayments.ToString("N0")
                </div>
                <div class="card-description">
                    Số giao dịch thành công
                </div>
            </div>

            <div class="summary-card">
                <div class="card-icon">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
                <div class="card-title">Thanh toán thất bại</div>
                <div class="card-value">
                    @Model.FailedPayments.ToString("N0")
                </div>
                <div class="card-description">
                    Số giao dịch thất bại
                </div>
            </div>

            <div class="summary-card">
                <div class="card-icon">
                    <i class="fa-solid fa-rotate-left"></i>
                </div>
                <div class="card-title">Tổng tiền hoàn trả</div>
                <div class="card-value">
                    @Model.RefundedAmount.ToString("N0")
                    <small style="font-size:13px">VNĐ</small>
                </div>
                <div class="card-description">
                    Tổng giá trị giao dịch đã hoàn tiền
                </div>
            </div>

            <div class="summary-card">
                <div class="card-icon">
                    <i class="fa-solid fa-money-bill-transfer"></i>
                </div>
                <div class="card-title">Doanh thu thực tế</div>
                <div class="card-value">
                    @Model.TotalRevenue.ToString("N0")
                    <small style="font-size:13px">VNĐ</small>
                </div>
                <div class="card-description">
                    Tổng tiền từ thanh toán thành công
                </div>
            </div>

        </div>

        <!-- MONTHLY REVENUE -->
        <div class="section">
            <h3>
                <i class="fa-solid fa-chart-column"></i>
                DOANH THU THEO THÁNG
            </h3>

            @if (Model.MonthlyRevenues.Any())
            {
                <div class="monthly-list">

                    @foreach (var item in Model.MonthlyRevenues)
                    {
                        double percent = (double)(item.Revenue / maxRevenue) * 100;

                        string barWidth = percent.ToString(
                            "0.##",
                            CultureInfo.InvariantCulture) + "%";

                        <div class="monthly-item">

                            <div class="monthly-label">
                                Tháng @item.Month/@item.Year
                            </div>

                            <div class="monthly-track">
                                <div class="monthly-fill"
                                     style="width: @barWidth">
                                </div>
                            </div>

                            <div class="monthly-value">
                                @item.Revenue.ToString("N0") VNĐ
                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty-data">
                    <i class="fa-solid fa-chart-column"></i>
                    <p>Chưa có dữ liệu doanh thu trong khoảng thời gian này.</p>
                </div>
            }
        </div>

        <!-- PAYMENT TRANSACTIONS -->
        <div class="section">

            <h3>
                <i class="fa-solid fa-list"></i>
                DANH SÁCH GIAO DỊCH THANH TOÁN
                (@Model.Transactions.Count giao dịch)
            </h3>

            <p style="color:#aaa; margin-bottom:20px;">
                Tổng số giao dịch:
                <strong style="color:#e0ad45;">
                    @Model.Transactions.Count
                </strong>
            </p>

            <div class="table-wrapper">

                <table>
                    <thead>
                        <tr>
                            <th>MÃ GIAO DỊCH</th>
                            <th>MÃ ĐẶT VÉ</th>
                            <th>KHÁCH HÀNG</th>
                            <th>EMAIL</th>
                            <th>SỐ TIỀN</th>
                            <th>PHƯƠNG THỨC</th>
                            <th>NGÀY THANH TOÁN</th>
                            <th>TRẠNG THÁI</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Transactions.Any())
                        {
                            foreach (var item in Model.Transactions)
                            {
                                string statusLabel = item.PaymentStatus;
                                string statusClass = "status-pending";

                                switch (item.PaymentStatus)
                                {
                                    case "Success":
                                        statusLabel = "Đã thanh toán";
                                        statusClass = "status-success";
                                        break;

                                    case "Pending":
                                        statusLabel = "Chờ thanh toán";
                                        statusClass = "status-pending";
                                        break;

                                    case "Failed":
                                        statusLabel = "Thất bại";
                                        statusClass = "status-failed";
                                        break;

                                    case "Refunded":
                                        statusLabel = "Đã hoàn tiền";
                                        statusClass = "status-refunded";
                                        break;
                                }

                                <tr>
                                    <td class="highlight">
                                        @(string.IsNullOrWhiteSpace(item.TransactionCode)
                                            ? "Chưa có mã"
                                            : item.TransactionCode)
                                    </td>

                                    <td>@item.BookingCode</td>

                                    <td>@item.CustomerName</td>

                                    <td>@item.Email</td>

                                    <td class="highlight">
                                        @item.Amount.ToString("N0") VNĐ
                                    </td>

                                    <td>@item.PaymentMethod</td>

                                    <td>
                                        @(item.PaymentDate.HasValue
                                            ? item.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm")
                                            : "Chưa thanh toán")
                                    </td>

                                    <td>
                                        <span class="status @statusClass">
                                            @statusLabel
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="empty-table">
                                    Chưa có giao dịch thanh toán trong khoảng thời gian này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

        <!-- FOOTER -->
        <div class="footer">
            AER AVIATION - HỆ THỐNG QUẢN LÝ ĐẶT VÉ MÁY BAY
        </div>

    </div>

</body>
</html>
