
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - FlightBookingAI</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="@Url.Content("~/Content/navbar.css")" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark flight-navbar"
         style="background-color: #123B72;">
        <div class="container">

            @Html.ActionLink("✈ FlightBookingAI", "Index", "Home",
                new { area = "" },
                new { @class = "navbar-brand fw-bold" })

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#flightNavbar"
                    aria-controls="flightNavbar"
                    aria-expanded="false"
                    aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="flightNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        @Html.ActionLink("Trang chủ", "Index", "Home",
                            new { area = "" },
                            new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Chuyến bay", "Index", "Flights",
                            new { area = "" },
                            new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        <span class="nav-link text-white-50"
                              title="Sắp ra mắt">
                            Khám phá
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "AITravel")">
                            Lịch trình AI
                        </a>
                    </li>


                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item dropdown flight-account-nav">
                            <button class="btn flight-account-btn dropdown-toggle"
                                    type="button"
                                    id="accountDropdown"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <svg class="flight-account-icon"
                                     xmlns="http://www.w3.org/2000/svg"
                                     width="20"
                                     height="20"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <circle cx="12" cy="8" r="3"></circle>
                                    <path d="M6.5 19a6 6 0 0 1 11 0"></path>
                                </svg>
                                Tài khoản
                            </button>


                            <ul class="dropdown-menu dropdown-menu-end flight-account-menu"
                                aria-labelledby="accountDropdown">

                                <!-- Thông tin đăng nhập -->
                                <li>
                                    <span class="dropdown-item-text flight-account-label">
                                        Đã đăng nhập
                                    </span>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <!-- Vé của tôi -->
                                <li>
                                    <a class="dropdown-item"
                                       href="@Url.Action("MyTickets", "Payment")">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="18"
                                             height="18"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             style="vertical-align:middle; margin-right:8px;"
                                             aria-hidden="true">
                                            <path d="M2 9a3 3 0 0 0 0 6v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a3 3 0 0 0 0-6V5a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v4Z"></path>
                                            <path d="M13 5v2"></path>
                                            <path d="M13 11v2"></path>
                                            <path d="M13 17v2"></path>
                                        </svg>

                                        Vé của tôi
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <!-- Đăng xuất -->
                                <li>
                                    @using (Html.BeginForm("Logout", "Account",
                                        FormMethod.Post,
                                        new { @class = "m-0" }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="dropdown-item flight-logout-btn">
                                            Đăng xuất
                                        </button>
                                    }
                                </li>

                            </ul>

                        </li>
                    }

                    else
                    {
                        <li class="nav-item flight-account-nav">
                            <a class="btn flight-account-btn"
                               href="@Url.Action("Login", "Account")">

                                <svg class="flight-account-icon"
                                     xmlns="http://www.w3.org/2000/svg"
                                     width="20"
                                     height="20"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <circle cx="12" cy="8" r="3"></circle>
                                    <path d="M6.5 19a6 6 0 0 1 11 0"></path>
                                </svg>

                                Tài khoản
                            </a>
                        </li>
                    }


                </ul>
            </div>
        </div>
    </nav>


    <!-- NỘI DUNG TRANG -->

    @if (ViewContext.RouteData.Values["controller"].ToString() == "Home"
        && ViewContext.RouteData.Values["action"].ToString() == "Index")
    {
        <main>
            @RenderBody()
        </main>
    }
    else
    {
        <main class="container body-content py-4">
            @RenderBody()
        </main>
    }


    <!-- FOOTER -->
    <footer class="text-white py-4"
            style="background-color: #0B2545;">
        <div class="container">
            <div class="row gy-3">

                <div class="col-md-5">
                    <h5 class="fw-bold">✈ FlightBookingAI</h5>
                    <p class="mb-0">
                        Nền tảng đặt vé máy bay và tư vấn
                        lịch trình du lịch thông minh bằng AI.
                    </p>
                </div>

                <div class="col-md-4">
                    <h5>Liên kết nhanh</h5>
                    <ul class="list-unstyled">
                        <li>
                            @Html.ActionLink("Trang chủ", "Index", "Home",
                                null,
                                new { @class = "text-white" })
                        </li>
                        <li>
                            @Html.ActionLink("Chuyến bay", "Index", "Flights",
                                null,
                                new { @class = "text-white" })
                        </li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h5>Thông tin</h5>
                    <p class="mb-0">Đồ án FlightBookingAI</p>
                    <p class="mb-0">ASP.NET MVC 5</p>
                </div>

            </div>

            <hr class="border-light" />

            <p class="text-center mb-0">
                &copy; @DateTime.Now.Year FlightBookingAI.
                All rights reserved.
            </p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
